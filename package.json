{
  "name": "tictactoe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Noughty Crosses: tic-tac-toe modes on a crafted 3D table.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check src test tools playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "unused": "knip",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run unused && npm run test",
    "assets": "node tools/fetch-assets.mjs",
    "audio": "node tools/fetch-audio.mjs",
    "lookdev:measure": "node tools/lookdev-measure.mjs",
    "e2e": "vite build && playwright test",
    "tables": "node tools/solve-tables.mjs",
    "notices": "node tools/notices.mjs",
    "itch": "vite build && node tools/itch-zip.mjs",
    "oss": "node tools/export-public.mjs",
    "desktop": "tauri build",
    "desktop:steam": "tauri build --features steam --no-bundle && node tools/steam-lib.mjs",
    "desktop:steam-linux": "npm run desktop && npm run desktop:steam && node tools/steam-linux.mjs",
    "android": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fluent/bundle": "^0.19.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "ffmpeg-static": "^5.3.0",
    "knip": "^6.42.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
