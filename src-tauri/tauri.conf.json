{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Noughty Crosses",
  "mainBinaryName": "noughty-crosses",
  "version": "1.0.0",
  "identifier": "dev.xilo.noughtsandvariants",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "linux": {
      "appimage": { "bundleMediaFramework": true }
    },
    "category": "Game",
    "shortDescription": "Tic-tac-toe modes on a crafted 3D table",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
